# --- Solana ---
RPC_URL=http://127.0.0.1:8899
# WS_URL=ws://127.0.0.1:8900        # derived from RPC_URL when empty
# PROGRAM_ID=                        # defaults to the id in the SDK's IDL

# --- HTTP API ---
PORT=8787
HOST=0.0.0.0
PUBLIC_URL=http://localhost:8787     # public base URL of this server
CORS_ORIGIN=*                        # set to your frontend origin in production
TRUST_PROXY=false                    # true only behind a reverse proxy that sets X-Forwarded-For

# --- Database (SQLite) ---
DATABASE_PATH=./data/launchpad.sqlite

# --- Indexer ---
INDEXER_ENABLED=true
POLL_INTERVAL_MS=2000
# START_SIGNATURE=                   # skip history older than this signature

# --- Keeper (auto graduation to Raydium) ---
KEEPER_ENABLED=false
# KEEPER_KEYPAIR=./keeper.json       # path or JSON array; needs ~0.05 SOL for fees
KEEPER_INTERVAL_MS=10000
KEEPER_COLLECT_FEES_MIN_LAMPORTS=0   # >0: also sweep protocol fees above this amount
KEEPER_PRIORITY_FEE_MICROLAMPORTS=0

# --- Metadata storage (token images + JSON) ---
STORAGE=local                        # local | pinata
UPLOAD_DIR=./data/uploads
# PINATA_JWT=
# PINATA_GATEWAY=https://gateway.pinata.cloud
MAX_IMAGE_BYTES=5242880
METADATA_FETCH_TIMEOUT_MS=5000
# ALLOW_HTTP_METADATA=false          # allow plain http metadata URIs (dev only)
